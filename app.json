{
  "expo": {
    "name": "Balance",
    "slug": "project-balance",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "projectbalance",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "backgroundColor": "#1A1614",
    "android": {
      "package": "com.projectbalance.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1614",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1614",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Satoshi-Regular.otf",
            "./assets/fonts/Satoshi-Medium.otf",
            "./assets/fonts/Satoshi-Bold.otf"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "SpendGrid",
              "displayName": "Spending grid",
              "description": "Daily spending, darker means more",
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/spend-grid.tsx"
              }
            },
            {
              "name": "MonthPulse",
              "displayName": "This month",
              "description": "Spent and received this month",
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/month-pulse.tsx"
              }
            }
          ]
        }
      ],
      [
        "./plugins/with-widget-previews",
        {
          "previews": {
            "spend_grid": "./assets/widget-previews/spend_grid.png",
            "month_pulse": "./assets/widget-previews/month_pulse.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "dark": {
            "colors": {
              "cropToolbarColor": "#1A1614",
              "cropToolbarIconColor": "#F3EBE2",
              "cropToolbarActionTextColor": "#F3EBE2",
              "cropBackButtonIconColor": "#F3EBE2",
              "cropBackgroundColor": "#1A1614"
            }
          },
          "colors": {
            "cropToolbarColor": "#1A1614",
            "cropToolbarIconColor": "#F3EBE2",
            "cropToolbarActionTextColor": "#F3EBE2",
            "cropBackButtonIconColor": "#F3EBE2",
            "cropBackgroundColor": "#1A1614"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ea03cedb-bcec-43d5-a4c8-348841402bd6"
      }
    },
    "owner": "mustpikeks-2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ea03cedb-bcec-43d5-a4c8-348841402bd6"
    },
    "ios": {}
  }
}
