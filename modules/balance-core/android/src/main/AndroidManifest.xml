<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets Settings list launcher apps (labels and icons) on Android 11+ without QUERY_ALL_PACKAGES. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <receiver
      android:name="expo.modules.balancecore.ReviewActionReceiver"
      android:exported="false" />
    <receiver
      android:name="expo.modules.balancecore.WidgetResizedReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="expo.modules.widgets.ACTION_WIDGET_RESIZED" />
      </intent-filter>
    </receiver>
    <service
      android:name="expo.modules.balancecore.BalanceListenerService"
      android:label="@string/balance_listener_label"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
